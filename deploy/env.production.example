##############################################################
# .env de PRODUCCIÓN – SistemaEncomienda
# IMPORTANTE: Copiar a /var/www/sistemaencomienda/src/.env
#             Nunca subir este archivo con datos reales al VCS.
##############################################################

APP_NAME="Sistema de Encomiendas"
APP_ENV=production
APP_KEY=                             # Generar con: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=America/Asuncion
APP_URL=https://tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# ── Base de Datos ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=encomiendabd
DB_USERNAME=encomiendas_user        # Usuario de producción (NO postgres)
DB_PASSWORD=CONTRASEÑA_SEGURA_AQUI  # Mínimo 20 caracteres, alfanumérico + símbolos

# ── Sesión & Cache ────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file

# ── Colas ────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ── Correo (opcional para notificaciones) ────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=noreply@tudominio.com
MAIL_PASSWORD=CONTRASEÑA_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="Sistema de Encomiendas"

# ── Logs ─────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error
